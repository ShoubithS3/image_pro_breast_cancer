# Optional operator-controlled paths, resolved on the server; not accepted from browsers.
MAMMO_MANIFEST=data/manifest.csv
MAMMO_ARTIFACTS=artifacts
MAMMO_STATE=state
# Web training defaults off. CLI training needs no token.
MAMMO_ENABLE_TRAINING=0
# If enabling web training, generate a strong token locally and export it securely.
# MAMMO_ADMIN_TOKEN=
